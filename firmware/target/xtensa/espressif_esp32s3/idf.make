#   Open      \______   \ ____   ____ |  | _\_ |__   _______  ___
#   Source     |       _//  _ \_/ ___\|  |/ /| __ \ /  _ \  \/  /
#   Jukebox    |    |   (  <_> )  \___|    < | \_\ (  <_> > <  <
#   Firmware   |____|_  /\____/ \___  >__|_ \|___  /\____/__/\_ \
#                     \/            \/     \/    \/            \/
#
# Build rules for the ESP-IDF-backed ESP32-S3 target (APP_TYPE=esp-idf).
#
# Rockbox compiles and archives; ESP-IDF links. IDF owns the linker script, the
# startup (call_start_cpu0 -> esp_startup_start_app -> app_main), the cache and
# MMU bring-up, PSRAM configuration, the C library and FreeRTOS. Those are the
# things a bare-metal port of this SoC has to reimplement by hand; borrowing the
# vendor's is why this target needs an SDK at all. The bare-metal link lives on
# the tagged branch (baremetal-pre-idf).
#
# Consequence worth stating: Rockbox's own linker script (app.lds), crt0 and an
# elf-to-image tool are not used on this path.

# IDF's own compile flags, harvested from its build graph by tools/configure and
# regenerated by the rule below. It is included rather than written out because
# the set of component include directories and CONFIG_ defines depends on the
# sdkconfig, which lives in the SDK.
-include $(BUILDDIR)/idf.make

# The IDF project that links the image. It lives in the target tree because the
# linker fragment in it decides where Rockbox's statics go -- PSRAM rather than
# the internal DRAM the SDK would otherwise use.
IDFDIR ?= $(FIRMDIR)/target/xtensa/espressif_esp32s3/idf-app
IDF_PROJECT ?= rockbox
IDFPY ?= idf.py

# This image links the platform C library, so Rockbox's own libc-header
# directories have to be searched *after* the platform's in the firmware
# domain: with firmware/include leading, the SDK's assert.h shim -- whose whole
# job is `#include_next <assert.h>' to reach newlib's unmodified one -- finds
# Rockbox's replacement instead and never reaches the real libc. The failure
# surfaces somewhere unrelated (a missing ESP_STATIC_ASSERT, an unknown `FILE'),
# which reads as a dialect problem and is an include-order one.
#
# The directories stay on INCLUDES because the other domain needs them leading;
# they are removed from this domain's flags with filter-out, which works
# whatever order the makefiles are read in.
#
#   LIBC_HDR_AFTER  firmware domain -- after the system directories
#   LIBC_HDR_FIRST  freestanding domain -- firmware/include is already on
#                   INCLUDES, so only firmware/libc/include, which an APP_TYPE
#                   build leaves off, has to be added back
ROCKBOX_LIB_HDRS := -I$(FIRMDIR)/include -I$(FIRMDIR)/libc/include
LIBC_HDR_AFTER := -idirafter $(FIRMDIR)/include -idirafter $(FIRMDIR)/libc/include
LIBC_HDR_FIRST := -I$(FIRMDIR)/libc/include

# The firmware domain compiles against the SDK's headers, so it takes the SDK's
# include path and the platform's own libc.
CFLAGS = $(filter-out $(ROCKBOX_LIB_HDRS),$(BASE_CFLAGS)) $(LIBC_HDR_AFTER) \
         $(IDF_CFLAGS) -DHAVE_SYSTEM_LIBC \
         -DCONFIG_LIBC_PICOLIBC_NEWLIB_COMPATIBILITY=0
# The SDK's CONFIG_ defines must not reach a SOURCES file, because that would
# let the SDK's configuration decide which Rockbox files get compiled; only its
# search paths and Rockbox's fallback headers go to the preprocessor. The
# search paths are needed there because mkdepfile scans with -MG, which reports
# an unresolved include as a bare name, and addtargetdir.pl then turns
# `esp_err.h' into a prerequisite with no rule -- a hard make error rather than
# a missing dependency.
PPCFLAGS += $(LIBC_HDR_AFTER) $(filter -I%,$(IDF_CFLAGS)) -DHAVE_SYSTEM_LIBC

# IDF's headers define a handful of names that Rockbox's own headers also define
# without a guard, so the target's own objects see redefinitions. -Wundef is
# useful everywhere else, so it is disabled for exactly the directory that
# reaches IDF rather than for the whole build.
$(BUILDDIR)/firmware/target/xtensa/%.o: CFLAGS += -Wno-undef

# Target files that reach an IDF driver whose headers pull FreeRTOS have to be
# compiled with IDF's include path leading, so FreeRTOS's queue.h is found
# rather than Rockbox's. Add to this list when a target file starts including
# anything that pulls FreeRTOS.h.
#
# It is one list because three things have to agree about it: the compile
# flags, the dependency scan (which has to record the headers this compile
# actually used), and the rebuild trigger when the harvested IDF flags change.
XTENSA_IDF_FIRST_SRC := $(FIRMDIR)/target/xtensa/espressif_esp32s3/sd-esp32s3.c \
                       $(FIRMDIR)/target/xtensa/espressif_esp32s3/spi-esp32s3.c \
                       $(FIRMDIR)/target/xtensa/paniclog.c
XTENSA_IDF_FIRST_OBJ := $(call c2obj,$(XTENSA_IDF_FIRST_SRC))

IDF_FIRST_CFLAGS = $(IDF_CFLAGS) \
                   $(filter-out $(ROCKBOX_LIB_HDRS),$(BASE_CFLAGS)) \
                   $(LIBC_HDR_AFTER) -DHAVE_SYSTEM_LIBC \
                   -DCONFIG_LIBC_PICOLIBC_NEWLIB_COMPATIBILITY=0

$(XTENSA_IDF_FIRST_OBJ): CFLAGS = $(IDF_FIRST_CFLAGS)
# Compiled against IDF's flags, so rebuilt when the harvest changes: without
# this a sdkconfig change recompiles IDF and leaves Rockbox's view of it frozen,
# which surfaces as a header found but a CONFIG_ define missing.
$(XTENSA_IDF_FIRST_OBJ): $(BUILDDIR)/idf.make

# The objects above are excluded from the default dependency scan and scanned
# with IDF's include order instead, so make.dep records FreeRTOS's queue.h for
# them rather than Rockbox's.
DEPSCAN_EXTRA = $(call mkdepfile_order,$(DEPFILE)_,$(XTENSA_IDF_FIRST_SRC), \
                 $(filter -I%,$(IDF_CFLAGS)))
DEP_SRCS = $(filter-out $(XTENSA_IDF_FIRST_SRC),$(SRC))

# Everything compiled in the firmware domain gets $(IDF_CFLAGS) -- the CFLAGS
# line above adds it to every object, not only the few that also need IDF's
# include path leading. A sdkconfig or component-set change therefore invalidates
# all of them. Without this the harvest refreshes only the handful bound to
# idf.make elsewhere and leaves the rest compiled against an obsolete sdkconfig.
# Pattern rules rather than an object list, because SRC and OTHER_SRC are not
# complete yet: a pattern rule's prerequisites are expanded when it is applied.
$(BUILDDIR)/firmware/%.o $(BUILDDIR)/apps/%.o $(BUILDDIR)/lib/%.o: $(BUILDDIR)/idf.make

.SECONDEXPANSION: # $$(OBJ) is not populated until after this

# Everything Rockbox compiled, in one archive.
#
# $(OBJ) is only the apps/ and other non-library sources -- a few dozen objects.
# The firmware sources live in FIRMLIB_OBJ and are already archived in
# libfirmware.a, which is a member of CORE_LIBS. Building librockbox.a from
# $(OBJ) alone and then excluding libfirmware.a from the link left every
# firmware symbol unreachable and the IDF link failed on a single undefined
# reference. Both are needed.
ROCKBOX_ARCHIVE := $(BUILDDIR)/lib/librockbox.a

$(ROCKBOX_ARCHIVE): $$(OBJ)
	$(call make_archive)

# VOICESPEEXLIB is not a codec: it is the second copy of libspeex that
# apps/voice_thread.c links against, built with VOICESPEEXFLAGS (no -DCODEC, no
# -ffunction-sections, -DROCKBOX_VOICE_CODEC) so the voice path can call the
# decoder directly from the firmware. It has to be a prerequisite of the
# generated cmake file as well as linked, because nothing else in the tree
# builds it.
#
# ROCKBOX_LINK_LIBS is recursive, and referenced with $$ in the rules below:
# CORE_LIBS and VOICESPEEXLIB are not populated until the subdir makefiles have
# been read, and this file is included before them.
ROCKBOX_LINK_LIBS = $(ROCKBOX_ARCHIVE) $(CORE_LIBS) $(VOICESPEEXLIB)

# Hand the archive list to CMake rather than writing it in the project: which
# archives exist depends on what the Rockbox configuration enables (rbcodec,
# skin_parser, utf8proc and fixedpoint are all conditional), so a list
# maintained in two places would silently link a stale set.
#
# The linker mapping and the two CMakeLists are prerequisites as well: they are
# the inputs that decide where sections go and what the link line looks like,
# and without them a change to main/rockbox_memory.lf would be picked up only
# by accident.
#
# Rewrite, and nudge CMake, only when the list actually changed. The archives
# are prerequisites of this file, so an unconditional rewrite plus touch re-ran
# CMake on every single build to tell it nothing. Nudging is needed at all
# because IDF builds the ninja graph itself: registering the generated file via
# CMAKE_CONFIGURE_DEPENDS makes ninja see it as an output twice and refuse to
# build. Touching a file CMake already tracks is the nudge that works, and it
# has to happen here rather than in CMake -- this file is generated after IDF
# has already been configured.
$(IDFDIR)/rockbox_libs.cmake: $$(ROCKBOX_LINK_LIBS) $(IDFDIR)/main/rockbox_memory.lf \
                              $(IDFDIR)/CMakeLists.txt $(IDFDIR)/main/CMakeLists.txt
	$(call PRINTS,GEN $(@F))
	$(SILENT)rm -f $@.new; \
	   echo '# generated by Rockbox make -- do not edit' >> $@.new; \
	   echo 'set(ROCKBOX_LIBS' >> $@.new; \
	   for l in $(ROCKBOX_LINK_LIBS); do echo "    $$l" >> $@.new; done; \
	   echo ')' >> $@.new
	$(SILENT)if cmp -s $@.new $@; then \
		rm -f $@.new; \
	else \
		mv -f $@.new $@; \
		touch $(IDFDIR)/main/CMakeLists.txt; \
	fi

# The archives are prerequisites of the image too, not just of the list above:
# an archive whose *contents* changed while its name stayed the same has to
# relink, and before this the image moved only when the set of archives moved.
#
# sdkconfig.defaults only *seeds* sdkconfig: IDF writes the file once and
# ignores the defaults forever after, so a change there lands in neither
# sdkconfig nor the harvested idf.make and the image is unchanged with nothing
# to say why. tools/meowkits3/idf-seedcheck makes the decision on content rather
# than mtime and explains itself.
#
# IDF owns the link, so it owns the ELF and the linker map -- but every other
# port leaves both in the build directory, and the goals that read them (make
# elfzip, make mapzip, tools/meowkits3/esp-layout-check, any symbol lookup) look
# there too. Copy them in rather than making each consumer know IDF's tree.
$(BUILDDIR)/$(BINARY): $$(IDFDIR)/rockbox_libs.cmake $$(ROCKBOX_LINK_LIBS)
	$(call PRINTS,IDF $(@F))
	$(SILENT)$(TOOLSDIR)/meowkits3/idf-seedcheck $(IDFDIR) "$(IDF_PATH)"
	$(SILENT)cd $(IDFDIR) && $(IDFPY) build
	$(SILENT)cp $(IDFDIR)/build/$(IDF_PROJECT).bin $@
	$(SILENT)cp $(IDFDIR)/build/$(IDF_PROJECT).elf $(BUILDDIR)/rockbox.elf
	$(SILENT)cp $(IDFDIR)/build/$(IDF_PROJECT).map $(BUILDDIR)/rockbox.map

# The flags IDF compiles its own sources with. tools/configure harvests this
# once; making it a target here means a rebuilt IDF graph (sdkconfig or a
# component set change) refreshes it instead of leaving Rockbox compiled against
# an obsolete sdkconfig -- that failure looks like a header found but a CONFIG_
# define missing, which reads as a code bug and is not one.
#
# IDF's own compile graph. After `make clean` (which does not fullclean IDF) or
# `make idf-clean` this does not exist, and tools/meowkits3/idf-flags cannot
# harvest from nothing, so generate it with `reconfigure`: that runs CMake --
# which is what emits compile_commands.json -- without compiling the components.
# CMake itself re-runs when sdkconfig or a CMakeLists changes, so this rule only
# ever fires when the graph is gone.
$(IDFDIR)/build/compile_commands.json: $(IDFDIR)/CMakeLists.txt \
                                       $(IDFDIR)/main/CMakeLists.txt \
                                       $(IDFDIR)/main/rockbox_memory.lf
	$(call PRINTS,IDF reconfigure)
	$(SILENT)cd $(IDFDIR) && $(IDFPY) reconfigure

$(BUILDDIR)/idf.make: $(IDFDIR)/build/compile_commands.json
	$(call PRINTS,IDF harvest compile flags)
	$(SILENT)$(TOOLSDIR)/meowkits3/idf-flags $(IDFDIR)/build -o $@

# Rockbox generated rockbox_libs.cmake, so clean removes it. What clean does
# NOT touch is IDF's build directory, and that is deliberate rather than lazy:
# SOURCES files are run through the *target compiler* while make parses the
# makefile, and those compilations need IDF's generated sdkconfig.h.
# Fullcleaning IDF from clean therefore breaks the very next `make`, at parse
# time, with "fatal error: sdkconfig.h: No such file or directory" -- and
# because a failed preprocess silently yields an empty file list, it does so in
# a way that looks like a missing source rather than a missing header.
# `idf-clean` is the goal that resets IDF state, and it rebuilds what it removes.
clean::
	$(SILENT)rm -f $(IDFDIR)/rockbox_libs.cmake

idf-clean:
	$(SILENT)cd $(IDFDIR) && $(IDFPY) fullclean
	$(SILENT)rm -f $(IDFDIR)/rockbox_libs.cmake
	# Re-establish the generated headers immediately: sdkconfig.h and
	# compile_commands.json are both needed before the next build can parse, and
	# reconfigure emits both without compiling the components.
	$(SILENT)cd $(IDFDIR) && $(IDFPY) reconfigure
	$(SILENT)$(TOOLSDIR)/meowkits3/idf-flags $(IDFDIR)/build -o $(BUILDDIR)/idf.make
.PHONY: idf-clean

# Flash and image-verification goals for this target.
include $(TOOLSDIR)/meowkits3/espflash.make
