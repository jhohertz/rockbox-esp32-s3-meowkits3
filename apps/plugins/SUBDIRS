#ifndef MEOWKIT_ESP32S3
/* Gated for MeowKit, but NOT for a keymap reason like the others and it should
 * not be assumed to be the same fix. apps/plugins/puzzles/puzzles.make is
 * included (plugins.make:77 walks PLUGINSUBDIRS) and does define the sgt-*
 * targets, yet not one object under apps/plugins/puzzles/ is ever compiled and
 * the link then fails with `undefined reference to plugin_start` -- i.e. the
 * .rock rule runs with an empty object list. puzzles/SOURCES has 26 entries and
 * every file it names exists, so the break is between that list and the compile
 * rule. puzzles/SOURCES is generated by resync.sh and says DO NOT MODIFY, so
 * the fix belongs in puzzles.make. Needs its own investigation. */
puzzles
#endif
#endif

