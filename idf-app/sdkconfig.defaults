# MeowKit ESP32-S3-WROOM-1-N16R8: 16 MB quad SPI flash + 8 MB octal PSRAM.
#
# These are the settings the bare-metal branch spent days getting right by hand
# (octal PSRAM timing, the flash MMU, cache configuration). Here they are
# configuration, not code.

CONFIG_IDF_TARGET="esp32s3"

# ---- flash ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---- PSRAM: octal, 80 MHz ----
# MODE_OCT is the whole point: the N16R8 module's PSRAM is an octal device on
# CS1. Getting this wrong is silent -- reads return garbage rather than faulting.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Keep small allocations in internal RAM. DMA descriptors in particular cannot
# live in PSRAM: GDMA takes the descriptor address from a 20-bit window based at
# 0x3FC00000, so a PSRAM address loses its high bits.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# ---- console: the board's only always-available serial is USB-Serial-JTAG ----
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_FREERTOS_HZ=1000

# ---- SD card is on non-default pins, 1-bit only ----
# CLK 47, CMD 48, D0 21. Only D0 is wired, so 1-bit is the ceiling, not a
# fallback. Without the GPIO matrix these pins are unreachable.
CONFIG_SDMMC_USE_GPIO_MATRIX=y

# ---- Bluetooth: the reason for this whole exercise ----
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
