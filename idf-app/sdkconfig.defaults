# MeowKit ESP32-S3-WROOM-1-N16R8: 16 MB quad SPI flash + 8 MB octal PSRAM.
#
# These are the settings the bare-metal branch spent days getting right by hand
# (octal PSRAM timing, the flash MMU, cache configuration). Here they are
# configuration, not code.

CONFIG_IDF_TARGET="esp32s3"

# ---- core clock ----
# 240 MHz, matching the stock MeowKit firmware (arduino-esp32) and CPU_FREQ in
# firmware/export/config/meowkits3.h. IDF's own default for this target is 160,
# so it has to be stated rather than assumed: Rockbox's udelay() counts core
# cycles against CPU_FREQ, and system-xtensa.c asserts the two agree, so
# leaving this unset is a compile error rather than a silent 1.5x timing skew.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---- flash ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---- app partition ----
# IDF's default single-app table gives the app 1 MB. Rockbox does not fit in it:
# the loaded image is ~1.07 MB before anything is trimmed, because it is Rockbox
# (code, fonts, language files, bitmaps, skins) on top of IDF's own text and
# rodata -- roughly 460 KB flash text, 520 KB flash rodata, 64 KB IRAM and 23 KB
# of initialized data. The failure is not subtle (esptool refuses the image), but
# it is a partition-table error, so it reads as a size problem rather than a
# configuration one. 16 MB of flash, 3 MB of app.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# ---- PSRAM: octal, 80 MHz ----
# MODE_OCT is the whole point: the N16R8 module's PSRAM is an octal device on
# CS1. Getting this wrong is silent -- reads return garbage rather than faulting.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Keep small allocations in internal RAM. DMA descriptors in particular cannot
# live in PSRAM: GDMA takes the descriptor address from a 20-bit window based at
# 0x3FC00000, so a PSRAM address loses its high bits.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# Claim .ext_ram.bss. Rockbox's audiobuffer, framebuffer and codec/plugin load
# buffers are linker symbols its core expects a linker script to place, and this
# path has no Rockbox linker script -- they are declared in that section by
# firmware/target/xtensa/memory-xtensa-syms.S instead. Without this option IDF
# does not claim the section, the buffers fall back to the 337 KB internal DRAM,
# and the link fails with dram0_0_seg overflowed by several megabytes.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# ---- console: the board's only always-available serial is USB-Serial-JTAG ----
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---- SD card is on non-default pins, 1-bit only ----
# CLK 47, CMD 48, D0 21. Only D0 is wired, so 1-bit is the ceiling, not a
# fallback. Without the GPIO matrix these pins are unreachable.

# ---- Bluetooth: the reason for this whole exercise ----
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Rockbox owns one core outright: its scheduler is cooperative and, when every
# Rockbox thread is blocked, it waits for the next tick inside the FreeRTOS task
# rather than returning from it. The idle task on that core therefore never runs
# and never feeds the watchdog, which resets the whole chip (TG1WDT_SYS_RST)
# looking like a hang. The watchdog still covers everything IDF itself does, on
# this core and the other one.
#
# This was left =y while hunting the dead-tick fault, precisely so the watchdog
# would name the stuck task and print a backtrace. It did, and the fault is
# fixed; back to n, because a Rockbox core with every thread blocked is normal.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_PANIC=y
# FreeRTOS tick rate. Rockbox's HZ is 100 and is not a per-target knob, so the
# only requirement here is that this be an exact multiple of it: timer-xtensa.c
# divides xTaskGetTickCount() by kernel_hz/HZ to make current_tick, and
# tick_start() panics if the division is not exact. 1000 Hz is IDF's default and
# what its own components -- the wireless stack in particular -- are written
# against.
#
# 500 Hz was tried once as a test of whether the missing isochronous frames were
# caused by the tick ISR delaying the USB interrupt. It was the wrong test: this
# app selects CONFIG_FREERTOS_CORETIMER_SYSTIMER_LVL1, so the tick runs at level 1
# and chains with the audio GDMA pass rather than blocking the level-2 USB
# handler. Measured with the rate halved: no change to the drop rate or to what
# was heard, which is what the level map predicts. Keep 1000.
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TICK_HOOK=y

# Rockbox does its own stack-overflow detection: switch_thread() checks
# thread->stack[0] against DEADBEEF. FreeRTOS fills the same buffer with
# tskSTACK_FILL_BYTE (0xa5) at creation and, with method 2, re-checks the bottom
# 16 bytes -- the same word Rockbox's canary lives in. The two cannot coexist on
# one buffer: with method 2 on, every Rockbox thread trips its own check on the
# first switch, because FreeRTOS legitimately overwrote the canary. Rockbox's
# check is the one that knows about Rockbox thread stacks, so IDF's stands down.
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_NONE=y
# CONFIG_FREERTOS_CHECK_STACKOVERFLOW_PTRVAL is not set
# CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY is not set

# Execute-in-place from PSRAM. Rockbox loads codec and plugin images into the
# PSRAM window (codecbuf/pluginbuf) and calls their entry points, which faults
# with InstructionFetchError unless the range is mapped for instruction fetch.
# CONFIG_SPIRAM_XIP_FROM_PSRAM is the helper for FETCH_INSTRUCTIONS + RODATA.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# Crash reporting. Both of these were the default, and together they made every
# fault this target hit unobservable: the panic handler itself lives in flash, so
# an exception raised while the flash cache is disabled (during a flash write, for
# one) cannot execute it -- the handler double-faults, IDF's re-entry guard fires
# ("Panic handler entered multiple times. Abort panic handling."), and the device
# restarts without ever printing a register dump. Putting the handler in IRAM lets
# it run regardless of cache state; halting instead of rebooting keeps the dump on
# the console, which is USB-Serial-JTAG and whose FIFO is discarded by the reset.
CONFIG_ESP_PANIC_HANDLER_IRAM=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y

# A hang has to end in a reset, not in silence. With PANIC unset the watchdog only
# prints a warning, and the warning goes to the USB-Serial-JTAG console, which the
# running app has already handed to the OTG wrap -- so it is invisible, and the chip
# stays hung with its endpoints half-initialised while the host keeps talking to a
# device that can no longer answer. Panic instead: the register dump is short-lived
# but xtensa_breadcrumb_rtc() and the RTC panic record live in RTC slow, which
# survives a watchdog-triggered reset, and the rebooting boot prints that trail over
# CDC. That is what makes a hang readable after the fact.
CONFIG_ESP_TASK_WDT_PANIC=y

# A panic should reboot, not halt. With PRINT_HALT the chip stops with the USB pad
# * mux still handed to the OTG wrap (that override is in the RTC domain and only a
# * power-on reset clears it), so the board keeps no console and no flash port until
# * someone unplugs it. Rebooting instead runs the boot hook that returns the pins to
# * USB-Serial-JTAG, prints the breadcrumb trail on a live console, and preserves
# * .noinit -- esp_restart is a chip reset, so the trail survives it.
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
# CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT is not set

# The interrupt watchdog. This was disabled during the OTG interrupt experiment
# because CPU 0's general-use pool is nearly full, but it is the only thing that
# covers a fault the task watchdog cannot see: a core stuck with interrupts
# disabled, or a storm of spurious interrupts that starves every thread. Both look
# identical from outside -- enumeration holds, buttons do nothing, the screen will
# not wake -- and without this the chip simply stays that way. Its alarm runs on
# the existing esp_timer interrupt rather than claiming a pool slot.
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=2000
CONFIG_ESP_INT_WDT_CHECK_CPU1=y
