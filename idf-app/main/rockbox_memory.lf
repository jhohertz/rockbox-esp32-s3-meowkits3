# Where Rockbox's static data goes.
#
# ESP-IDF's internal DRAM segment is 0x53700 bytes (337 KB) and IDF's own
# startup, FreeRTOS, drivers and heap already claim a large part of it before
# Rockbox is linked in. Rockbox's statics do not fit in what is left, so some of
# them have to go to the 8 MB of octal PSRAM the board carries.
#
# The default here is internal DRAM, and PSRAM is granted object by object.
# That is the opposite of the first version of this file, which moved every
# Rockbox archive to PSRAM and named the exceptions, and it was changed because
# the exceptions were not enumerable. Thread stacks in Rockbox are plain
# `static long foo_stack[...]` arrays -- one per driver, in that driver's .bss
# (powermgmt.c, storage.c, usb.c, codec_thread.c, audio_thread.c, apps/main.c,
# and more). Moving whole archives therefore moved the stacks, and a Rockbox
# thread switched onto a PSRAM stack produced a double exception inside
# __xtensa_libgcc_window_spill with a stack pointer in the PSRAM window: the
# register spill area and the stack both live in cache-backed memory the core
# cannot maintain per address. That is the same hazard that keeps
# memory-xtensa-syms.S's thread-0 stack out of PSRAM, just arrived at by
# accident. Anything that can *be* a stack has to stay in DRAM, and there is no
# complete list of those objects, so the safe rule is: stay in DRAM unless a
# named object is known to be pure data.
#
# The same argument covers DMA. On esp32s3 the D-cache only covers IRAM0 and
# DRAM0 (cache_ll_vaddr_to_cache_level_id accepts nothing else), GDMA takes a
# descriptor address from a 20-bit window based at 0x3FC00000, and IDF's SD
# driver does no cache maintenance on the caller's buffer at all -- its
# esp_cache_msync() calls are compiled out behind SOC_CACHE_INTERNAL_MEM_VIA_-
# L1CACHE, which this part does not define. So anything that can be the
# destination of a storage or audio transfer stays in DRAM too: that rules out
# disk_cache.o, which is an SDHOST read destination, and pcm-xtensa.o,
# usb.o and usb_storage.o, whose thread stacks and DWC buffers are on a master
# that cannot reach the PSRAM window.
#
# i2s-xtensa.o is the exception that proves the rule rather than breaks it: it is
# pinned to rb_dram, yet its dma_buf carries PSRAM_BSS_ATTR of its own, because
# GDMA can reach PSRAM for *buffers* (the 20-bit window is only the descriptor
# address register) while its desc[] must stay internal. Per-symbol attributes
# therefore beat the object-level scheme for anything DMA-related -- and that is
# exactly why counting an object's .bss is not the same as counting DRAM: the
# framebuffer is in PSRAM through IRAM_LCDFRAMEBUFFER while lcd-16bit.o still
# looks 150 KB in a per-object census.
#
# What is moved is the large, CPU-only data: language and unicode tables,
# bidi, the rbcodec buffering, lang_core's markup and resample's history buffers.
# These are read and written by the core and never handed to a DMA engine.
#
# scroll_engine.o and playlist.o were on this list and came off it. Both look
# like pure data by size (26 KB and 7.6 KB) but each also holds a thread stack:
# scroll_engine.c has `static ... scroll_stack[]` and playlist.c has
# `playlist_stack`, and the archive-level entry moved the whole .bss with them.
# The symptom was a deterministic Cache error / "MMU entry fault" the first time
# the scheduler resumed one of those threads -- EXCVADDR repeating on every boot.
# The rule is not "is this object big and inert", it is "does this object contain
# something a core can be executing on".  PSRAM at 80 MHz is
# slower than internal SRAM, so this is a performance cost; it is paid for the
# alternative, which is not fitting at all.
#
# Initialized data (.data) stays in internal DRAM: IDF has no PSRAM target for
# it, because .ext_ram.bss is NOLOAD and there is nothing to load initial values
# from. It is about 23 KB including IDF's own, so it is not the pressure point.
#
# The mapping blocks are named rb_firmware, rb_apps, ... rather than all being
# called 'main', even though 'main' is the component that registers this file.
# ldgen keys fragments by that name and fails the build outright on a duplicate
# ("Duplicate definition of fragment 'main'"), and one block can only carry one
# archive -- so one name per archive is forced. The name is otherwise inert: it
# is the archive line that decides what the entries apply to.

[scheme:rb_psram]
entries:
    bss -> extern_ram
    common -> extern_ram

# The default, spelled out everywhere so that the PSRAM entries below read as
# the deliberate exceptions they are.
[scheme:rb_dram]
entries:
    bss -> dram0_bss
    common -> dram0_bss

[mapping:rb_firmware]
archive: libfirmware.a
entries:
    unicode (rb_psram)
    bidi (rb_psram)
    # logf.o -- logfbuffer, the ring the serial console replays. Pure data, no thread
    # stack and never a DMA destination. It used to carry a PSRAM section attribute in
    # firmware/logf.c; that attribute is gone because this fragment is the mechanism
    # that owns placement, and a portable .c file should not know about PSRAM.
    logf (rb_psram)
    # dir.o -- open_streams[] is filestr_base + ns_scan_info + dirent: directory
    # scan cursors plus one parsed entry. Storage reads land in a separate buffer
    # and are parsed into this, so it is not itself a DMA destination. An earlier
    # note here classed it alongside disk_cache.o as a read destination; it isn't.
    dir (rb_psram)
    # fileobj_mgr.o -- fobindings[], the file-object binding table. Metadata only.
    fileobj_mgr (rb_psram)
    # file.o -- its ONLY bss symbol is open_streams[], the file-descriptor table
    # (2108 bytes). Storage reads land in the disk cache / a caller buffer, never
    # here, so it is not a DMA destination -- the same reasoning that already puts
    # dir.o and fileobj_mgr.o in PSRAM. This exists to buy back internal SRAM:
    # dram0_0_seg had 4376 bytes free and CONFIG_ESP_PANIC_HANDLER_IRAM needs
    # roughly 5472, so without a donor like this the panic handler cannot be moved
    # into IRAM at all -- see firmware/target/xtensa/MEMORY.md for the budget.
    file (rb_psram)
    # system.o -- the cpu_boost() bookkeeping: the CPU_BOOST_LOGGING ring
    # (cpu_boost_calls[64][MAX_PATH] = 16,640 bytes) plus boost_counter, cpu_idle,
    # cpu_boost_first, cpu_boost_calls_count and cpu_boost_track_message. Enabling
    # HAVE_ADJUSTABLE_CPU_FREQ turns the ring on through system.h:43-46 (it also
    # needs ROCKBOX_HAS_LOGF and NUM_CORES == 1, both true here), and dram0_0_seg
    # had 1,020 bytes free, so the ring is what makes the seam unaffordable rather
    # than the clock change itself.
    #
    # It meets both halves of the rule above: no thread stack and no DMA
    # destination -- it is a text log plus five words of bookkeeping, read only by
    # Debug -> CPU frequency's boost log.
    #
    # What makes moving zero-initialised bookkeeping legal at all is that
    # .ext_ram.bss is not merely NOLOAD but explicitly cleared: IDF's init_bss() in
    # cpu_start.c:449 covers only _bss_start.._bss_end (dram0), and the PSRAM range
    # is memset by esp_psram_bss_init() (esp_psram.c:767, called from
    # cpu_start.c:771), which is present in this image. Without that, boost_counter
    # would start random and ++boost_counter == 1 would never fire. Note this only
    # covers .bss: cpu_frequency is .data and stays in internal DRAM, so udelay()
    # does not start reading a clock word out of PSRAM on every call.
    system (rb_psram)
    # memory-xtensa-syms holds rockbox_stack and the audio/codec/plugin buffers.
    # The stack must be in DRAM (FreeRTOS switches to it in assembly); the big
    # buffers are already in .ext_ram.bss by their own section attribute, which
    # this archive-level entry does not override.
    memory-xtensa-syms (rb_dram)
    pcm-xtensa (rb_dram)
    i2s-xtensa (rb_dram)
    * (rb_dram)

[mapping:rb_apps]
archive: librockbox.a
entries:
    language (rb_psram)
    # Pure UI state, checked individually rather than by size: none of these
    # defines a thread stack or hands a buffer to a DMA engine, which are the
    # two things that make an object have to stay in internal DRAM. tree.o holds
    # the browser context, playlist_viewer.o the viewer state, filetypes.o the
    # registered-type table. Measured headroom before this was 3592 bytes of
    # dram0_0_seg, which is not enough to add a diagnostic to; these three give
    # back about 5.4 KB.
    tree (rb_psram)
    playlist_viewer (rb_psram)
    # line.o -- lines[], the text-line layout state gui/line.c builds while drawing
    # (1,056 bytes of .bss plus a 4-byte index). Pure UI state: no thread stack, never
    # a DMA destination.
    #
    # This entry exists because enabling feature flags costs DRAM in a place that has
    # nothing to do with the features. HAVE_QUICKSCREEN, AB_REPEAT_ENABLE, HAVE_ALBUMART
    # and HAVE_JPEG add almost no .bss of their own -- albumart.o and jpeg_load.o have
    # none at all, quickscreen.o has one byte -- but each new setting appends an entry
    # to the config-value table, and dram0_0_seg then overflowed by 72 bytes against
    # 184 bytes of previous headroom. Donating 1,060 covers it.
    #
    # It is not settings.o, which has 2,340 bytes of .bss and would be the obvious
    # donor: that is global_settings, read on the audio path, and this fragment already
    # excludes talk.o and beep.o for exactly that reason. Nor skin_tokens.o, which was
    # tried first and did nothing: its 1,016 bytes are all .data, and .data cannot move
    # here because .ext_ram.bss is NOLOAD, so there would be nothing to load initial
    # values from. Only .bss and COMMON are movable, which is the real constraint when
    # buying back internal SRAM.
    line (rb_psram)
    filetypes (rb_psram)
    # tagtree.o is the tagcache's browse-menu layer. Its only large static is
    # uniqbuf, 64 KB of pure scratch handed to tagcache_search_set_uniqbuf() and
    # never to a DMA engine, and the file defines no thread stack -- so it meets
    # both halves of the rule above. It has to move: enabling HAVE_TAGCACHE put
    # 65,536 (uniqbuf) plus tagcache.o's 20,480-byte thread stack into a segment
    # that had single-digit KB of headroom, and dram0_0_seg overflowed by 86,736.
    # tagcache.o itself deliberately stays in DRAM because of that stack.
    tagtree (rb_psram)
    # Three more to cover the rest of what HAVE_TAGCACHE costs. Each was checked
    # against the same two tests rather than by size:
    #   playback.o -- static_id3_entries[], the metadata cache. No stack.
    #     (dir.o and fileobj_mgr.o are firmware/common objects and belong to
    #     libfirmware.a, so they are granted in that mapping instead -- putting
    #     them here silently did nothing.)
    playback (rb_psram)
    # lang_core.o -- its only static is language_strings[] (3508 bytes), the
    # compiled markup table. No thread stack, never a DMA destination. Added to
    # buy internal SRAM for the USB stack: dram0_0_seg was 7488 bytes over.
    lang_core (rb_psram)
    # Deliberately NOT moved despite looking like data: scroll_engine.o and
    # playlist.o each contain a thread stack, dir.o and disk_cache.o are disk
    # read destinations, talk.o and beep.o feed the audio path, and
    # thread-idf.o holds the TCB pool that xPortCheckValidTCBMem() requires in
    # internal RAM.
    * (rb_dram)

[mapping:rb_rbcodec]
archive: librbcodec.a
entries:
    buffering (rb_psram)
    # resample.o -- resample_data (152) and resample_out_bufs (2304), the
    # resampler's history and staging buffers. Written by the codec thread, never
    # by the GDMA completion path, and no stack. Same purpose as lang_core above.
    resample (rb_psram)
    * (rb_dram)

[mapping:rb_skin]
archive: libskin_parser.a
entries:
    * (rb_psram)

[mapping:rb_utf8]
archive: libutf8proc.a
entries:
    * (rb_psram)

[mapping:rb_fixed]
archive: libfixedpoint.a
entries:
    * (rb_psram)

[mapping:rb_speexvoice]
archive: libspeex-voice.a
entries:
    * (rb_psram)
